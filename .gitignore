# Python
__pycache__/

# virtual environment (macOS dev env; Windows build creates its own)
mtk_gui/

# build output
build/
dist/
dist_win/
# generated User Guide HTML site (docs/help/*.md is the source of truth)
docs/help/_build/

# runtime output
logs/
event/
archive/
audit/
demo/
reports/
# quick commands: per-station runtime storage (built-in defaults apply
# when the file is missing)
config/commands.json
# real-board fat.py run artifacts (never ship in the Windows package)
yaml_plan/examples/**/fat_result.json
# yaml plan workspace: runtime/demo products only (not versioned)
yaml_plan/*
mtkgui/config/yamlbuild_state.json

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Aligned with .trae/.ignore (TRAE index filter).
# NOTE: *.spec is intentionally NOT ignored here — PyInstaller spec files
# (MTK_GUI.spec, MTK_GUI_windows.spec) are versioned source files.
# ---------------------------------------------------------------------------

# Python cache artifacts (*.pyc / *.pyo / *.pyd all covered here)
*.py[cod]
*$py.class

# virtual environments (mtk_gui/ handled above)
.venv/
venv/
env/

# build artifacts
release/
*.exe
*.zip
*.tar.gz

# log files (logs/ and event/ handled above)
*.csv
*.log
*.txt.tmp

# OS junk (Windows)
Thumbs.db
desktop.ini

# editor swap / workspace files
*.swp
*.sublime-workspace

# temp dirs
tmp/
temp/

# TRAE workspace local config (index filter only, not for versioning)
.trae/
