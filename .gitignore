# Python
__pycache__/

# virtual environment (macOS dev env; Windows build creates its own)
mtk_gui/

# build output
build/
dist/
dist_win/
# generated User Guide HTML site (docs/help/*.md is the source of truth)
docs/help/_build/
# 2026-11-07: vendor instrument manuals (29 MB of PDF) are reference material
# for writing the User Guide, not source - keep them out of git.
docs/instruments/

# runtime output
logs/
event/
archive/
audit/
demo/
reports/
# 2026-10-17: report output now lives next to the program (defaults
# "DUT Report" / "Event Report", names modifiable at runtime)
DUT Report/
Event Report/
report_folders.json
# quick commands: per-station runtime storage (built-in defaults apply
# when the file is missing)
config/commands.json
# 2026-11-07: the yaml_plan/ workspace is retired - plans live in a project
# folder under projects/. Nothing is shipped from it any more.
# deprecated publish target - a Draft/Final built in the source tree is scratch
config/plans/
mtkgui/config/yamlbuild_state.json
# per-station runtime state (SharePoint cookies / statistics) - never ship
mtkgui/config/sharepoint_state/
mtkgui/config/statistics/
mtkgui/config/sharepoint_upload.json

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Aligned with .trae/.ignore (TRAE index filter).
# NOTE: *.spec is intentionally NOT ignored here — PyInstaller spec files
# (MTK_GUI.spec, MTK_GUI_windows.spec) are versioned source files.
# ---------------------------------------------------------------------------

# Python cache artifacts (*.pyc / *.pyo / *.pyd all covered here)
*.py[cod]
*$py.class

# virtual environments (mtk_gui/ handled above)
.venv/
venv/
env/

# build artifacts
release/
*.exe
*.zip
*.tar.gz

# log files (logs/ and event/ handled above)
*.csv
*.log
*.txt.tmp

# OS junk (Windows)
Thumbs.db
desktop.ini

# editor swap / workspace files
*.swp
*.sublime-workspace

# temp dirs
tmp/
temp/

# TRAE workspace local config (index filter only, not for versioning)
.trae/

# PyInstaller workpath (build_windows.ps1)
.build_tmp/

